# --- Server ---
ENVIRONMENT=development
PORT=8000
# Allowed browser origin(s), comma-separated. The matching localhost/127.0.0.1
# spelling of each entry is allowed automatically.
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Local MongoDB by default. Swap for an Atlas SRV URI when ready:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=visionaryx

# --- Auth / JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email (stub/console backend by default) ---
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@visionaryx.app

# --- Optional: plug a real LLM in later for the Future Self Chatbot ---
# Leave empty to use the built-in rule-based/template engine.
LLM_PROVIDER=
LLM_API_KEY=
